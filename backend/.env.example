# ---------------------------------------------------------------------------
# ArthaShield - example environment configuration
#
# Copy this file to `backend/.env` for local development:
#   cp backend/.env.example backend/.env      (Linux/macOS)
#   Copy-Item backend/.env.example backend/.env   (Windows)
#
# NEVER commit a real `.env` file. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# --- Backend (Django) ------------------------------------------------------
ENVIRONMENT=development
DEBUG=True

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Comma separated hostnames the API answers on (production only).
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite (backend/db.sqlite3).
# For PostgreSQL, set a separately provisioned database URL and include a
# compatible PostgreSQL driver in the backend dependencies. render.yaml does
# not provision a database.
DATABASE_URL=

# Comma separated extra origins allowed to call the API in production.
# The deployed Vercel frontend is allowed by default.
CORS_ALLOWED_ORIGINS=

# --- Optional: live AI analysis -------------------------------------------
# Without a key the advisor runs its deterministic offline fallback and labels
# the response "Offline Rule-Based Financial Insights". The key is only ever
# read from the environment and is never stored or logged.
GEMINI_API_KEY=

# The model used for optional live analysis. The service default is kept aligned
# with Google's current stable Gemini Flash model; override only when needed.
GEMINI_MODEL=gemini-3.8-flash

# --- Frontend (Vite) -------------------------------------------------------
# Where the frontend sends API calls. Use the deployed backend in production.
VITE_API_BASE_URL=http://localhost:8000/api/v1
